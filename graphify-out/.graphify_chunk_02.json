{"nodes":[{"id":"GX_WORKS2_IL_Spec","label":"GX-Works2 IL CSV Format Specification","file_type":"document","source_file":"Notes/GX_WORKS2_IL_Spec.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"OPERATION_SCENARIO","label":"REFRIGER Charging Machine Operation Scenario","file_type":"document","source_file":"Notes/OPERATION_SCENARIO.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"PLC_PROGRAM_STRUCTURE","label":"REFRIGER Charging Machine PLC Program Structure","file_type":"document","source_file":"Notes/PLC_PROGRAM_STRUCTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"alarm_per_line_plan","label":"Alarm Per-Line Separation Plan","file_type":"document","source_file":"Notes/alarm_per_line_plan.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"MELSEC_QL_Manual","label":"MELSEC-Q/L Programming Manual (Common Instruction)","file_type":"document","source_file":"Notes/MELSEC_QL_Programming_Manual(Common_Instruction).pdf","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"GX_WORKS2_IL_Spec_Wrapped_TSV","label":"Wrapped TSV Quoting Model","file_type":"rationale","source_file":"Notes/GX_WORKS2_IL_Spec.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"GX-Works2 emits non-standard wrapped-TSV: outer quote wrapping, inner doubled quotes, first field bare. Root cause of broken round-trips if misunderstood."},{"id":"GX_WORKS2_IL_Spec_Row_Types","label":"IL Row Types (Type A/B/C)","file_type":"rationale","source_file":"Notes/GX_WORKS2_IL_Spec.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Type A=label, Type B=instruction head with step, Type C=continuation with extra operand. Critical for correct parse/generate."},{"id":"GX_WORKS2_IL_Spec_Rung_Composition","label":"Rung Composition Rules","file_type":"rationale","source_file":"Notes/GX_WORKS2_IL_Spec.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Each rung: exactly one load (LD/LDI/LDP/LDF), then series/parallel conditions, then outputs. MPS/MPP paired. ANB/ORB are block connectors, not rung starts."},{"id":"GX_WORKS2_IL_Spec_Device_Notation","label":"Device Address Notation Rules","file_type":"rationale","source_file":"Notes/GX_WORKS2_IL_Spec.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"M/L hex in docs→decimal in CSV. X/Y=UPPER hex. D/T/K=decimal. U<n>\\G<addr> for intelligent buffer. K/H/E constants without zero-padding."},{"id":"GX_WORKS2_IL_Spec_Verified_Coding_Rules","label":"Verified IL Coding Rules (REF Project)","file_type":"rationale","source_file":"Notes/GX_WORKS2_IL_Spec.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Timer=OUT not TMR. Avoid CJ in IL CSV. Note column must be empty. M/L hex→decimal. Max 8 outputs per rung. Device comment CSV header='AAAA'."},{"id":"PLC_PROGRAM_STRUCTURE_POU_Modules","label":"POU Module Structure","file_type":"rationale","source_file":"Notes/PLC_PROGRAM_STRUCTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"11 POUs: idata (init/mapping), gmes (PC comm), MAIN (mode/step), setting (config), gunvac/unitvac/vacchec/refinj (process), alarm, ad, 485, spc (stats). Always ON or step-triggered."},{"id":"PLC_PROGRAM_STRUCTURE_Device_Map","label":"L/M/D/X/Y Device Allocation Strategy","file_type":"rationale","source_file":"Notes/PLC_PROGRAM_STRUCTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"L=retentive latch bits. M=volatile step/coil/DI mirror. D0-D299=retentive params (even-addr for 32-bit). X/Y via mapping files, never direct reference in logic."},{"id":"PLC_PROGRAM_STRUCTURE_System_Config","label":"System Configuration Variations","file_type":"rationale","source_file":"Notes/PLC_PROGRAM_STRUCTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Single program for 1L1G/1L2G/2L2G/2L4G via D228(LineCount), D230(GunPerLine). D234 switches REF Only vs REF+OIL. Gun Index=Line×D230+GunLocal."},{"id":"PLC_PROGRAM_STRUCTURE_Data_Flow","label":"HMI-PLC-Field-PC Data Flow Architecture","file_type":"rationale","source_file":"Notes/PLC_PROGRAM_STRUCTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"HMI writes M400-M416 (momentary→self-hold/toggle), reads D0-D107. PC writes D180-D189/D230-D249. X→M via idata, M→Y via output mapping. Cycle-done clears PC write area."},{"id":"PLC_PROGRAM_STRUCTURE_Safety_PLC","label":"Safety PLC Interface Protocol","file_type":"rationale","source_file":"Notes/PLC_PROGRAM_STRUCTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Safety PLC monitors E-stop independently. Main runs only when SafetyOK(M30B=X0B) ON. Reset handshake: M50→Y1C. L40(EMG Stop)=global stop."},{"id":"PLC_PROGRAM_STRUCTURE_Analog_Scaling","label":"Analog Input Scaling (ad.csv)","file_type":"rationale","source_file":"Notes/PLC_PROGRAM_STRUCTURE.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Per-line Pressure/Temperature/Vacuum scaling: DMOV raw→D*scale→D/divisor→EU register. Moving average or 1st-order lag filter before EU update."},{"id":"alarm_per_line_plan_Line_Independence","label":"Line Independence Principle","file_type":"rationale","source_file":"Notes/alarm_per_line_plan.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Shared latches L42-L4A mixed L0 and L1 sources, causing cross-line blocking. Per-line latch separation required for true independent operation."},{"id":"alarm_per_line_plan_Per_Line_Latches","label":"Per-Line Alarm Latch Design","file_type":"rationale","source_file":"Notes/alarm_per_line_plan.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"L42-L4A kept for L0 (GunVac/UnitVac/VacLeak/Inj/Pressure/Temp). L70-L78 allocated for L1. Per-line ALARM RESET: M403(L0), M405(L1). Single shared buzzer Y30."},{"id":"alarm_per_line_plan_GMES_Result_Codes","label":"GMES Result Code Mapping","file_type":"rationale","source_file":"Notes/alarm_per_line_plan.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"D7012(L0)/D8012(L1) stores result codes: 1=OK, 2=VacuumNG, 3=GunVacNG, 4=UnitVacNG, 5=VacCheckNG, 6=OperatorStop, 7=NoneFlow, 8=TimeOver, 9=BackFlow, 10=DataNotMatch, 11=RecvTimeOver."},{"id":"alarm_per_line_plan_Manual_Mode_Select","label":"Manual Mode Select→START Pattern","file_type":"rationale","source_file":"Notes/alarm_per_line_plan.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Changed from direct-execute to select→START: function buttons set M420-M423, START reads selection and sets corresponding step bit, then clears selection."},{"id":"OPERATION_SCENARIO_Gun_Type","label":"Gun Type (1-Sol Base / H+L Fast+Normal)","file_type":"rationale","source_file":"Notes/OPERATION_SCENARIO.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Type 0=Base 1-Sol, Type 1=H+L(Fast+Normal) 2-Sol. Gun Type per D32/D46/D60/D74. Oil mirrors same solenoid structure when D234=1."},{"id":"OPERATION_SCENARIO_Oil_Mode","label":"Oil Mode (REF Only / REF+OIL)","file_type":"rationale","source_file":"Notes/OPERATION_SCENARIO.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"D234=0: REF Only (VacCheck→Refrig→Exhaust→Complete). D234=1: REF+OIL (VacCheck→Oil→Refrig→Exhaust→Complete). Oil uses same gun type solenoid structure."},{"id":"OPERATION_SCENARIO_Process_Steps","label":"Process Step Sequence","file_type":"rationale","source_file":"Notes/OPERATION_SCENARIO.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Auto: IDLE→PRECHECK→GUN VAC→UNIT VAC→VAC CHECK→[OIL INJ]→REFRIG INJ→EXHAUST→COMPLETE. Manual: select function then START, runs one step only."},{"id":"OPERATION_SCENARIO_Injection_Source","label":"Injection Source (Barcode PC / Local Model)","file_type":"rationale","source_file":"Notes/OPERATION_SCENARIO.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Barcode (PC) mode: PC writes amount to D-register, system matches preset table for Model#. Local mode: user inputs Model# directly, looks up preset injection amount."},{"id":"OPERATION_SCENARIO_Reset_Types","label":"Reset Types (Hard / Soft)","file_type":"rationale","source_file":"Notes/OPERATION_SCENARIO.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Hard Reset=physical RESET push button. Soft Reset=HMI screen RESET button. Both return system to IDLE state."},{"id":"MAIN_POU","label":"MAIN POU - Mode/Step/Lamp Control","file_type":"code","source_file":"src_md/MAIN.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"idata_POU","label":"idata POU - Init/Input Mapping/Output Mapping","file_type":"code","source_file":"src_md/idata.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"gmes_POU","label":"gmes POU - PC Communication / GMES Interface","file_type":"code","source_file":"src_md/gmes.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"setting_POU","label":"setting POU - Configuration and Gun Settings Sync","file_type":"code","source_file":"src_md/setting.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"gunvac_POU","label":"gunvac POU - Gun Vacuum Sequence","file_type":"code","source_file":"src_md/gunvac.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"unitvac_POU","label":"unitvac POU - Unit Vacuum Sequence","file_type":"code","source_file":"src_md/unitvac.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"vacchec_POU","label":"vacchec POU - Vacuum Check (Leak Test)","file_type":"code","source_file":"src_md/vacchec.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"refinj_POU","label":"refinj POU - Refrigerant/Oil Injection","file_type":"code","source_file":"src_md/refinj.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"alarm_POU","label":"alarm POU - Alarm Latch/Buzzer/Alarm Reset","file_type":"code","source_file":"src_md/alarm.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"ad_POU","label":"ad POU - Analog Input Scaling (Pressure/Temp/Vacuum)","file_type":"code","source_file":"src_md/ad.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"rs485_POU","label":"485 POU - RS-485 Data Mirror","file_type":"code","source_file":"src_md/485.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null},{"id":"spc_POU","label":"spc POU - Statistics/Bombe Display","file_type":"code","source_file":"src_md/spc.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null}],"edges":[{"sourc