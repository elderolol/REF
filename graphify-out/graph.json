    {
      "label": "Line Independence Design Principle",
      "file_type": "rationale",
      "source_file": "Notes/PLC_PROGRAM_STRUCTURE.md",
      "source_location": "\u00a70-3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Line 0 and Line 1 operate fully independently with dedicated vacuum pumps and plumbing. Each line has its own step M-relays and interlock signals. Only Emergency Stop and Safety Fault affect both lines globally. This design allows a single program to support 1L/1G through 2L/4G configurations without code duplication.",
      "id": "line_independence_design",
      "community": 0,
      "norm_label": "line independence design principle"
    },
    {
      "label": "Single Program for All Configurations (1L/1G ~ 2L/4G)",
      "file_type": "rationale",
      "source_file": "Notes/PLC_PROGRAM_STRUCTURE.md",
      "source_location": "\u00a70",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Goal: a single standard program that works across 1L/1G, 1L/2G, 2L/2G, 2L/4G configurations. Configuration parameters D228 (Line Count) and D230 (Gun/Line) enable or disable Line 1 and Gun 1 logic via CJ (conditional jump) instructions. This avoids maintaining separate programs per configuration, reducing maintenance burden and testing effort.",
      "id": "single_program_multi_config_rationale",
      "community": 0,
      "norm_label": "single program for all configurations (1l/1g ~ 2l/4g)"
    },
